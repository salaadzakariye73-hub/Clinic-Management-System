# ---- Server ----
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/clinic_db
# Frontend origin(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5173

# ---- Auth ----
# Use a long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Clinic ----
CLINIC_NAME=Rugta Caafimaadka
# IANA timezone used to decide what "today" means for queue numbers
CLINIC_TIMEZONE=Africa/Mogadishu

# ---- Notifications (Twilio) ----
# If TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN are empty the system runs in SIMULATION mode:
# messages are printed in the server console instead of being sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio SMS-capable number (E.164)
TWILIO_PHONE_NUMBER=
# Twilio WhatsApp sender (sandbox default shown)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# sms | whatsapp | both
NOTIFY_CHANNEL=sms
# Country code added to local numbers (252 = Somalia)
DEFAULT_COUNTRY_CODE=252
# so = Somali, en = English
MESSAGE_LANG=so
